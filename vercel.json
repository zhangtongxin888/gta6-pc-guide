{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.gta6pc.org" }],
      "destination": "https://gta6pc.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/release-date", "destination": "/release-date/index.html" },
    { "source": "/pc-specs", "destination": "/pc-specs/index.html" },
    { "source": "/play", "destination": "/play/index.html" },
    { "source": "/play/", "destination": "/play/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
